{
  "name": "mini-tricky",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first Trickest-style bug bounty workflow builder — desktop app & web GUI.",
  "author": "MKlolbullen",
  "main": "electron/main.cjs",
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": "cd backend && python3 -m uvicorn src.main:app --host 127.0.0.1 --port 5000 --reload",
    "dev": "concurrently -k -n be,fe,el -c red,cyan,yellow \"npm run backend:dev\" \"npm run frontend:dev\" \"wait-on http://127.0.0.1:5000/api/health http://127.0.0.1:5173 && electron .\"",
    "start": "npm run frontend:build && electron .",
    "web": "concurrently -k -n be,fe -c red,cyan \"npm run backend:dev\" \"npm run frontend:dev\"",
    "electron:dev": "npm run dev",
    "electron:start": "electron .",
    "desktop:dev": "npm run dev",
    "desktop:start": "npm run start",
    "desktop:build": "npm run frontend:build && electron-builder",
    "desktop:build:mac": "npm run frontend:build && electron-builder --mac",
    "desktop:build:win": "npm run frontend:build && electron-builder --win",
    "desktop:build:linux": "npm run frontend:build && electron-builder --linux"
  },
  "build": {
    "appId": "com.minitricky.app",
    "productName": "mini-tricky",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "extraMetadata": {
      "version": "0.2.0-beta"
    },
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "build/icon.png",
      "build/icon.ico",
      "!node_modules",
      "!backend",
      "!docs"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*", "!.venv/**", "!src/__pycache__/**"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "artifactName": "${name}-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "dmg": {
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  }
}
